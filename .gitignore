dist/
build/
*.egg-info/
*.egg
wheels/
MANIFEST

# ── Testing ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
nosetests.xml
pytest.xml

# ── Type checking ─────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
.ruff_cache/

# ── Blix databases (NEVER commit live databases) ─────────────────────
# All SQLite databases produced at runtime
*.db
*.db-shm
*.db-wal
*.db-journal

# Named databases explicitly
hgshm.db
vectors.db
policy.db
blix_memory.db

# ── Blix runtime data directories ────────────────────────────────────
# Default memory/data directories created at runtime
memory_data/
blix_data/
.blix/

# Experiment results (snapshots, metrics, reports)
results/
runs/
output/
outputs/
artifacts/

# Config snapshots exported at runtime
config_snapshot.json
config_snapshot.yaml

# ── Logs ─────────────────────────────────────────────────────────────
*.log
*.log.*
logs/

# ── IDE / editor ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
.project
.pydevproject

# ── Jupyter ───────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Profiling ─────────────────────────────────────────────────────────
*.prof
*.lprof
*.pstats

# ── Embeddings / model weights (can be large) ─────────────────────────
