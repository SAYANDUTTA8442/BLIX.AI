# ── Python ───────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

