*.safetensors
*.gguf
*.ckpt
*.pt
*.pth
model_cache/
.cache/

# ── Benchmark artefacts ───────────────────────────────────────────────
benchmark_results/
ablation_reports/
*.benchmark.json

# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Secrets (never commit) ────────────────────────────────────────────
*.pem
*.key
*.cert
*.crt
secrets.yaml
secrets.json
.secrets/

# ── Tarballs / archives (deliverables go to outputs/, not the repo) ───
*.tar.gz
*.zip
*.tar.bz2
*.tgz
